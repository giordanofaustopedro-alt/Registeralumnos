generator client {
  provider = "prisma-client-js"
}

datasource db {
 
  provider  = "postgresql"
 
}

// ==========================================
// ENUMS (Especialidades y Tipos)
// ==========================================

enum Especialidad {
  CICLO_BASICO // Para 1°, 2° y 3° año
  HUMANIDADES  // Corresponde a división A (4°, 5°, 6°)
  INFORMATICA  // Corresponde a división B (4°, 5°, 6°)
}

enum TipoResponsable {
  PADRE
  MADRE
  TUTOR
}

enum TipoDocumento {
  FICHA_MEDICA
  AUTORIZACION
  OTRO
}

// ==========================================
// MODELO DE CURSOS Y ESTRUCTURA ESCOLAR
// ==========================================

model Curso {
  id           String        @id @default(uuid())
  anio         Int           // 1, 2, 3, 4, 5, 6
  division     String        // "A" o "B"
  especialidad Especialidad? @default(CICLO_BASICO)

  estudiantes Estudiante[]

  creadoEn DateTime @default(now())

  @@unique([anio, division]) // Evita duplicar "1° A", "5° B", etc.
}

// ==========================================
// MODELO DE ESTUDIANTES Y SUS RELACIONES
// ==========================================

model Estudiante {
  id        String   @id @default(uuid())
  nombre    String
  apellido  String
  dni       String   @unique
  email     String?
  direccion String?
  curso     String?  // Guarda el año en texto ("1°", "2°", "3°", "4°", "5°", "6°")
  division  String?  // Guarda "A" o "B"
  fotoUrl   String?

  // Relación opcional con el modelo Curso
  cursoId  String?
  cursoRef Curso?  @relation(fields: [cursoId], references: [id], onDelete: SetNull)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  responsables   Responsable[]
  infoMedica     InfoMedica?
  documentos     Documento[]
  amonestaciones Amonestacion[]
  sanciones      Sancion[]
  historial      Historial[]

  @@index([dni])
  @@index([apellido, nombre])
}

model Responsable {
  id           String @id @default(uuid())
  estudianteId String

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  tipo       TipoResponsable?
  parentesco String?
  nombre     String
  apellido   String?
  dni        String?
  telefono   String?
  email      String?
  direccion  String?

  @@index([estudianteId])
}

model InfoMedica {
  id           String @id @default(uuid())
  estudianteId String @unique

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  grupoSanguineo     String?
  alergias            String?
  medicacion         String?
  enfermedades       String?
  problemasCardiacos String?
  observaciones      String?
}

model Documento {
  id           String @id @default(uuid())
  estudianteId String

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  tipo       TipoDocumento @default(OTRO)
  nombre     String?
  titulo     String
  archivoUrl String
  creadoEn   DateTime      @default(now())

  @@index([estudianteId])
}

model Amonestacion {
  id           String @id @default(uuid())
  estudianteId String

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  motivo      String
  descripcion String?
  fecha       DateTime @default(now())

  @@index([estudianteId])
}

model Sancion {
  id           String @id @default(uuid())
  estudianteId String

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  tipo        String
  categoria   String?
  motivo      String
  descripcion String?
  fecha       DateTime @default(now())

  firmadaPorEstudiante Boolean   @default(false)
  fechaFirma           DateTime?

  @@index([estudianteId])
}

model Historial {
  id           String @id @default(uuid())
  estudianteId String

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  tipo        String
  categoria   String?
  motivo      String
  descripcion String?
  fecha       DateTime @default(now())

  @@index([estudianteId])
}

model Recurso {
  id             String   @id @default(uuid())
  titulo         String
  descripcion    String?
  nivelEducativo String
  categoria      String
  archivoUrl     String
  esDescargable  Boolean  @default(true)
  creadoEn       DateTime @default(now())
}