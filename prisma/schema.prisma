generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Mantenlo si usas Supabase
}
model Curso {
  id           String        @id @default(uuid())
  anio         Int
  division     String
  especialidad Especialidad? @default(CICLO_BASICO)
  creadoEn     DateTime      @default(now())
  estudiantes  Estudiante[]

  @@unique([anio, division])
}

model Estudiante {
  id             String         @id @default(uuid())
  dni            String         @unique
  nombre         String
  apellido       String
  curso          String?
  division       String?
  creadoEn       DateTime       @default(now())
  actualizadoEn  DateTime       @updatedAt
  cursoId        String?
  direccion      String?
  email          String?
  fotoUrl        String?
  amonestaciones Amonestacion[]
  documentos     Documento[]
  cursoRef       Curso?         @relation(fields: [cursoId], references: [id])
  historial      Historial[]
  infoMedica     InfoMedica?
  responsables   Responsable[]
  sanciones      Sancion[]

  @@index([dni])
  @@index([apellido, nombre])
}

model Responsable {
  id           String           @id @default(uuid())
  estudianteId String
  parentesco   String?
  nombre       String
  dni          String?
  telefono     String?
  email        String?
  apellido     String?
  direccion    String?
  tipo         TipoResponsable?
  estudiante   Estudiante       @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@index([estudianteId])
}

model InfoMedica {
  id                 String     @id @default(uuid())
  estudianteId       String     @unique
  grupoSanguineo     String?
  alergias           String?
  medicacion         String?
  enfermedades       String?
  observaciones      String?
  problemasCardiacos String?
  estudiante         Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
}

model Documento {
  id           String        @id @default(uuid())
  estudianteId String
  titulo       String
  archivoUrl   String
  creadoEn     DateTime      @default(now())
  nombre       String?
  tipo         TipoDocumento @default(OTRO)
  estudiante   Estudiante    @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@index([estudianteId])
}

model Amonestacion {
  id           String     @id @default(uuid())
  estudianteId String
  motivo       String
  descripcion  String?
  fecha        DateTime   @default(now())
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@index([estudianteId])
}

model Sancion {
  id                   String     @id @default(uuid())
  estudianteId         String
  tipo                 String
  categoria            String?
  motivo               String
  fecha                DateTime   @default(now())
  descripcion          String?
  fechaFirma           DateTime?
  firmadaPorEstudiante Boolean    @default(false)
  profesorId           String?
  estudiante           Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  profesor             Profesor?  @relation(fields: [profesorId], references: [id])

  @@index([profesorId])
  @@index([estudianteId])
}

model Profesor {
  id               String           @id @default(uuid())
  nombre           String
  apellido         String
  cargo            String
  firmaUrl         String?
  activo           Boolean          @default(true)
  creadoEn         DateTime         @default(now())
  email            String?
  sanciones        Sancion[]
  solicitudesFirma SolicitudFirma[]

  @@index([apellido, nombre])
}

model SolicitudFirma {
  id         String    @id @default(uuid())
  token      String    @unique
  profesorId String
  creadoEn   DateTime  @default(now())
  expiraEn   DateTime
  usadoEn    DateTime?
  profesor   Profesor  @relation(fields: [profesorId], references: [id], onDelete: Cascade)

  @@index([profesorId])
  @@index([expiraEn])
}

model Historial {
  id           String     @id @default(uuid())
  estudianteId String
  tipo         String
  categoria    String?
  motivo       String
  descripcion  String?
  fecha        DateTime   @default(now())
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@index([estudianteId])
}

model Recurso {
  id             String   @id @default(uuid())
  titulo         String
  descripcion    String?
  nivelEducativo String
  categoria      String
  archivoUrl     String
  esDescargable  Boolean  @default(true)
  creadoEn       DateTime @default(now())
}

enum Especialidad {
  HUMANIDADES
  INFORMATICA
  CICLO_BASICO
}

enum TipoResponsable {
  PADRE
  MADRE
  TUTOR
}

enum TipoDocumento {
  FICHA_MEDICA
  AUTORIZACION
  OTRO
}
